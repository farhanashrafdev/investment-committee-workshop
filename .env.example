# Copy to .env and adjust. Never put AWS keys in this file: boto3 finds credentials
# through `aws login`, `aws configure sso`, environment variables or an instance role.

AWS_REGION=us-east-1

# Amazon Nova models (first-party AWS models). Verified invocable on 2026-11-23.
SUPERVISOR_MODEL_ID=us.amazon.nova-pro-v1:0
SPECIALIST_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Bedrock guardrail (create with: python main.py create-guardrail)
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
# Also attach the guardrail to every model call (not only to untrusted documents). Default off.
ATTACH_GUARDRAIL_TO_MODELS=false

# Cost estimate. Leave empty to show "pricing not configured".
# Values below: AWS Price List API, us-east-1, on-demand, effective 2026-11-01 (USD per 1,000 tokens).
# Nova 2 Lite price is the global cross-Region inference rate.
MODEL_PRICING_JSON={"us.amazon.nova-pro-v1:0": {"input_per_1k": 0.0008, "output_per_1k": 0.0032}, "global.amazon.nova-2-lite-v1:0": {"input_per_1k": 0.0003, "output_per_1k": 0.0025}}

# Timeouts, retries and limits
BEDROCK_CONNECT_TIMEOUT_S=10
BEDROCK_READ_TIMEOUT_S=120
BEDROCK_MAX_RETRIES=4
RUN_BUDGET_S=300
MAX_CALLS_PER_SPECIALIST=2

# Optional OpenTelemetry tracing (Strands StrandsTelemetry)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# STRANDS_CONSOLE_TRACING=true

LOG_LEVEL=INFO
